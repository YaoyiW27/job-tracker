# Copy to .env for local dev. Both local scripts and the Vercel deploy use the
# same (Neon) Postgres database.

# Neon connection strings:
#   DATABASE_URL = the POOLED url (…-pooler.…, has ?sslmode=require) — used at runtime
#   DIRECT_URL   = the DIRECT url (no -pooler)                       — used by prisma db push / migrate
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Optional — enables `npm run score` (LLM fit scorer). Leave unset to run without scoring.
# ANTHROPIC_API_KEY=
# Optional — override the scorer model (default claude-opus-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Access protection for the deployed site. When set, the app requires HTTP Basic
# auth with this password (any username). Leave unset for open local dev.
# APP_PASSWORD=
