# Copy to .env for local dev.
DATABASE_URL="file:./dev.db"

# Optional — enables the `npm run score` LLM fit scorer. Leave unset to run without scoring.
# ANTHROPIC_API_KEY=
# Optional — override the scorer model (default claude-opus-5; e.g. claude-haiku-4-5 for cheaper bulk runs).
# ANTHROPIC_MODEL=
